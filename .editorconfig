# =========================
# EditorConfig
# =========================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# =========================
# Python
# =========================

[*.py]
indent_style = space
indent_size = 4

# =========================
# HTML
# =========================

[*.html]
indent_style = space
indent_size = 2

# =========================
# CSS / JS / JSON
# =========================

[*.{css,js,json}]
indent_style = space
indent_size = 2

# =========================
# YAML
# =========================

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# =========================
# TOML
# =========================

[*.toml]
indent_style = space
indent_size = 2

# =========================
# Markdown
# =========================

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# =========================
# Makefile
# IMPORTANTE:
# Make exige TAB
# =========================

[{Makefile,Makefile.*,*.mk}]
indent_style = tab

# =========================
# Dockerfile
# =========================

[Dockerfile*]
indent_style = space
indent_size = 2

# =========================
# CSV
# =========================

[*.csv]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
